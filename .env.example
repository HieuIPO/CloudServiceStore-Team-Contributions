MSSQL_SA_PASSWORD=LocalDev#Cloud2026!
SEED_ADMIN_PASSWORD=LocalDev#Admin2026!
JWT_SIGNING_KEY=local-development-only-signing-key-2026-change-me
NEWSDATA_API_KEY=replace-me-with-a-newsdata-api-key
SEED_VISUAL_QA_DATA=false

# Contact email notification (disabled by default; never commit SMTP credentials)
CONTACT_EMAIL__ENABLED=false
CONTACT_EMAIL__HOST=smtp.gmail.com
CONTACT_EMAIL__PORT=587
CONTACT_EMAIL__USE_SSL=true
CONTACT_EMAIL__USERNAME=
CONTACT_EMAIL__PASSWORD=
CONTACT_EMAIL__FROM_ADDRESS=
CONTACT_EMAIL__FROM_DISPLAY_NAME=CloudServiceStore
CONTACT_EMAIL__ADMIN_RECIPIENT_ADDRESS=
CONTACT_EMAIL__TIMEOUT_SECONDS=10

# Cloudflare Turnstile (disabled by default; secret stays outside Git)
CONTACT_TURNSTILE__ENABLED=false
CONTACT_TURNSTILE__SECRET_KEY=
CONTACT_TURNSTILE__EXPECTED_ACTION=contact_submit
CONTACT_TURNSTILE__EXPECTED_HOSTNAME=

# Public site key is safe to expose, but must be available during the frontend build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
